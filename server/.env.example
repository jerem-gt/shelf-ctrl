PORT=3001
DATA_DIR=./data
SESSION_SECRET=dev-secret-not-for-production
NODE_ENV=development
# Les comptes se gèrent dans l'application : au premier démarrage, le jeton de création du premier
# compte (admin) est écrit dans les logs.
# En production (derrière HTTPS), activer le cookie Secure :
# SECURE_COOKIE=true
# Optionnel : sources supplémentaires pour la résolution des codes-barres
GOOGLE_BOOKS_API_KEY=
TMDB_API_KEY=
# Facultatif : URL publique (sans slash final), pour les liens des e-mails « mot de passe oublié »
# APP_URL=http://localhost:5173
# Facultatif : envoi d'e-mails. Sans SMTP, le lien de réinitialisation est écrit dans les logs.
# SMTP_USER sert aussi d'expéditeur (sinon SMTP_FROM). En local, Mailpit sans authentification :
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_FROM=shelfctrl@localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# TLS direct (sinon STARTTLS) : true par défaut sur le port 465 seulement
# SMTP_SECURE=
