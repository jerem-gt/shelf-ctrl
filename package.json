{
  "name": "shelfctrl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "test": "npm run test --workspace=client && npm run test --workspace=server",
    "test:coverage": "npm run test:coverage --workspace=client && npm run test:coverage --workspace=server",
    "start": "npm run start --workspace=server",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@jerem-gt/ctrl-shared": "github:jerem-gt/ctrl-shared#v1.9.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "bcrypt": false,
    "better-sqlite3": false,
    "esbuild": false,
    "@scarf/scarf": false
  }
}
