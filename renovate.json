{
  "extends": ["config:recommended", "group:allNonMajor", "group:react", "helpers:pinGitHubActionDigests"],
  "baseBranchPatterns": ["develop"],
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Mineures/patchs automergées une fois la CI verte (check requis sur develop)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Dockerfile et ci.yml (container) montent de version Node ensemble",
      "matchPackageNames": ["node"],
      "matchDatasources": ["docker", "node-version"],
      "groupName": "node",
      "addLabels": ["node"],
      "prBodyNotes": [
        "Si majeure : aligner aussi `@types/node` (server/package.json) et la règle `allowedVersions` dans renovate.json."
      ]
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
